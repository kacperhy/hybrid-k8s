#cloud-config
# Bramka WireGuard VNet <-> VPN (generowane przez Terraform, infra/azure/gateway.tf)
package_update: true
packages:
  - wireguard
  - iptables

write_files:
  - path: /etc/sysctl.d/99-wg-gateway.conf
    content: |
      net.ipv4.ip_forward = 1
  - path: /etc/wireguard/wg0.conf
    permissions: "0600"
    content: |
      [Interface]
      Address = ${wg_address}/32
      PrivateKey = ${wg_private_key}
      # Maskarada w obie strony: ruch z VPN wchodzi do VNet z adresem bramki,
      # a ruch z AKS wchodzi do VPN z adresem ${wg_address} (dozwolonym przez UFW na VM k3s).
      PostUp = iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE; iptables -t nat -A POSTROUTING -o wg0 -j MASQUERADE
      PostDown = iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE; iptables -t nat -D POSTROUTING -o wg0 -j MASQUERADE

      [Peer]
      PublicKey = ${pi_public_key}
%{ if wg_preshared_key != "" ~}
      PresharedKey = ${wg_preshared_key}
%{ endif ~}
      Endpoint = ${pi_endpoint}
      AllowedIPs = ${vpn_cidr}
      PersistentKeepalive = 25

runcmd:
  - sysctl --system
  - systemctl enable --now wg-quick@wg0
