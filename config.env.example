# Skopiuj do config.env i uzupełnij, potem: ./scripts/01-configure.sh
GITHUB_USER=twoj-login-github
GIT_REPO_URL=https://github.com/twoj-login-github/hybrid-k8s.git
DOMAIN=serwerfrajerow.top            # app.DOMAIN -> Traffic Manager, onprem.DOMAIN -> Twoje IP (DDNS)
LOCATION=polandcentral               # ten sam region co w infra/azure/terraform.tfvars
AKS_DNS_LABEL=hybryda-kacper         # ten sam co aks_dns_label w terraform.tfvars
K3S_TLS_SAN=10.10.20.6               # adres(y) API k3s dla kubectl z innej maszyny, np. IP w WireGuard
