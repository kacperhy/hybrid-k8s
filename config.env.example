# Skopiuj do config.env i uzupełnij, potem: ./scripts/01-configure.sh
GITHUB_USER=twoj-login-github
GIT_REPO_URL=https://github.com/twoj-login-github/hybrid-k8s.git

# --- Sieć VPN (WireGuard na Raspberry Pi) ---
VPN_CIDR=10.10.20.0/24               # tylko z tej sieci dostępne są SSH, 80/443 i API k3s
APP_URL=http://10.10.20.1:8080            # adres aplikacji dla użytkowników = HAProxy na Pi
ONPREM_INGRESS_IP=10.10.20.6         # Traefik w k3s (VM)
AZURE_INGRESS_IP=10.50.1.250         # Traefik w AKS (wewnętrzny LB, = ingress_ip w Terraform)

# --- VM z k3s ---
K3S_TLS_SAN=10.10.20.6               # adres VM w WireGuard (pierwszy = node-ip k3s); po przecinku kolejne nazwy/IP API
LAN_CIDR=                            # opcjonalnie: sieć domowa, z której też wolno SSH (np. 192.168.68.0/22)
